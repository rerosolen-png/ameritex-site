{
  "name": "ameritex-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site institucional e catálogo online da Ameritex – importadora de tecidos e plásticos (ameritex.com.br)",
  "homepage": "https://ameritex.com.br",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs --watch",
    "serve": "node scripts/serve.mjs --no-build",
    "check": "node scripts/check.mjs",
    "test": "npm run build && npm run check",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rerosolen-png/ameritex-site.git"
  },
  "keywords": [
    "ameritex",
    "static-site",
    "seo",
    "catalogo",
    "importadora",
    "pvc"
  ],
  "license": "UNLICENSED"
}
