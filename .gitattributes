# Normalize line endings: LF in the repository, native on checkout
* text=auto eol=lf

# Source files
*.mjs text
*.js text
*.css text
*.html text
*.json text
*.md text
*.yml text
*.yaml text
*.txt text
*.xml text
*.svg text

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
